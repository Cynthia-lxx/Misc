{
  "schemaVersion": 1,
  "_meta": {
    "purpose": "把源于游戏 UI 的资源包改造为通用 UI 词汇；命名只表达用途与特征",
    "usage": "python 10-templates/apply-naming.py --dry-run / --apply",
    "generatedNote": "法律与考据元数据不属于『命名』，按 policy.retained 原样保留"
  },
  "policy": {
    "principle": "对外命名（路径、组件标签、导出符号、CSS 变量、JSON 键、配置 id、i18n 键、界面文案、视图 id）一律使用通用 UI 语义；不出现游戏域词",
    "retained": [
      "SPDX / MIT 许可头与 LICENSE-MIT.txt（法律义务）",
      "licence-audit.json 中的品牌名与商标说明（法律事实）",
      "manifest / inventory 中指向上游源码的路径与行号（考据出处，不是命名）",
      "文件头注释里的上游 .cs 路径（溯源，不构成对外 API）"
    ],
    "excludedFiles": [
      "00-overview/licence-audit.json",
      "00-overview/LICENSE-MIT.txt",
      "00-overview/naming-map.json"
    ],
    "excludedDirs": ["dist", ".codebuddy", "__pycache__"],
