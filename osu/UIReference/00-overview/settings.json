      "source": "osu.Game/Graphics/Cursor/OsuTooltipContainer.cs:27-55"
    },
    {
      "id": "motion.reduce",
      "type": "boolean",
      "default": false,
      "appliesTo": { "cssVar": "--motion-scale", "attribute": "data-reduce-motion" },
      "origin": "kit-added",
      "source": "上游全仓无 ReduceMotion/prefers-reduced-motion（见 licence-audit.json 与调研报告 C4）；此项为本资源包新增的全局动效降级开关"
    },
    {
      "id": "motion.duration.fast",
      "type": "integer",
      "default": 120,
      "unit": "ms",
      "appliesTo": { "cssVar": "--duration-fast" },
      "origin": "upstream",
      "source": "调研报告 C2：短反馈 40-200ms 取中值"
    },
    {
      "id": "motion.duration.normal",
      "type": "integer",
      "default": 300,
      "unit": "ms",
      "appliesTo": { "cssVar": "--duration-normal" },
      "origin": "upstream",
      "source": "调研报告 C2：标准转场 300-600ms 下界"
    },
    {
      "id": "motion.duration.transition",
      "type": "integer",
