    {
      "id": "hud.visibility",
      "type": "enum",
      "default": "always",
      "values": ["always", "hide-during-gameplay", "never"],
      "appliesTo": { "attribute": "data-hud" },
      "origin": "upstream",
      "source": "osu.Game/Configuration/OsuConfigManager.cs:353 / Configuration/HUDVisibilityMode.cs:9-19"
    },
    {
      "id": "storyboard.enabled",
      "type": "boolean",
      "default": true,
      "appliesTo": { "attribute": "data-storyboard" },
      "origin": "upstream",
      "source": "osu.Game/Configuration/OsuConfigManager.cs:343-347"
    }
  ]
}
