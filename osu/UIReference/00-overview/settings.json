{
  "schemaVersion": 1,
  "_meta": {
    "source": "osu.Game/Configuration/OsuConfigManager.cs + 各 UI 组件常量",
    "licence": "MIT (upstream) / see licence-audit.json",
    "note": "origin=upstream 表示数值源自上游 MIT 源码；origin=kit-added 表示本资源包为弥补上游缺失而新增"
  },
  "settings": [
    {
      "id": "theme.scheme",
      "type": "enum",
      "default": "argon",
      "values": ["red", "orange", "lime", "green", "aquamarine", "blue", "purple", "plum", "pink"],
      "appliesTo": { "attribute": "data-theme" },
      "origin": "upstream",
      "source": "osu.Game/Overlays/OverlayColourScheme.cs:8-57"
    },
    {
      "id": "theme.hue",
      "type": "number",
      "default": 200,
      "range": [0, 360],
      "appliesTo": { "cssVar": "--theme-hue" },
      "origin": "upstream",
      "source": "osu.Game/Overlays/OverlayColourProvider.cs:20-70"
    },
    {
      "id": "ui.scale",
      "type": "number",
      "default": 1.0,
      "range": [0.8, 1.6],
      "step": 0.05,
      "appliesTo": { "cssVar": "--ui-scale" },
      "origin": "upstream",
      "source": "osu.Game/Configuration/OsuConfigManager.cs:192-195 / Graphics/Containers/ScalingContainer.cs:100-115"
    },
    {
      "id": "ui.parallax",
      "type": "number",
      "default": 1.0,
      "range": [0, 2],
      "step": 0.1,
      "appliesTo": { "cssVar": "--parallax-strength" },
      "origin": "upstream",
      "source": "osu.Game/Configuration/OsuConfigManager.cs:139-141 / Graphics/Containers/ParallaxContainer.cs:20-93"
    },
    {
      "id": "ui.holdActivationDelay",
      "type": "integer",
      "default": 200,
      "range": [0, 2000],
      "unit": "ms",
      "appliesTo": { "cssVar": "--hold-delay" },
      "origin": "upstream",
      "source": "osu.Game/Configuration/OsuConfigManager.cs:197 / Graphics/Containers/HoldToConfirmContainer.cs"
    },
    {
      "id": "ui.hoverFeedback",
      "type": "boolean",
      "default": true,
      "appliesTo": { "attribute": "data-hover-feedback" },
      "origin": "upstream",
      "source": "osu.Game/Graphics/UserInterface/HoverSounds.cs:21-46 (视觉反馈部分)"
    },
    {
      "id": "ui.tooltipDelay",
      "type": "integer",
      "default": 250,
      "range": [0, 2000],
      "unit": "ms",
      "appliesTo": { "cssVar": "--tooltip-delay" },
