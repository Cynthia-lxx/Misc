      "appliesTo": { "cssVar": "--duration-transition" },
      "origin": "upstream",
      "source": "osu.Game/Screens/Backgrounds/BackgroundScreen.cs:16-22"
    },
    {
      "id": "motion.duration.intro",
      "type": "integer",
      "default": 800,
      "unit": "ms",
      "appliesTo": { "cssVar": "--duration-intro" },
      "origin": "upstream",
      "source": "osu.Game/Graphics/Containers/WaveContainer.cs:19-24"
    },
    {
      "id": "graphics.blur",
      "type": "number",
      "default": 0,
      "range": [0, 1],
      "step": 0.01,
      "appliesTo": { "cssVar": "--blur-level" },
      "origin": "upstream",
      "source": "osu.Game/Configuration/OsuConfigManager.cs:343-347,149"
    },
    {
      "id": "graphics.dim",
      "type": "number",
      "default": 0.5,
      "range": [0, 1],
      "step": 0.01,
      "appliesTo": { "cssVar": "--dim-level" },
